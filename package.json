{
  "name": "deskformat",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "lint": "eslint ."
  },
  "dependencies": {
    "ajv": "^6.15.0",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "js-yaml": "^5.2.2",
    "jsonpath-plus": "^10.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "next": "16.2.6",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "39.2.6",
    "electron-builder": "26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.deskformat.app",
    "productName": "DeskFormat",
    "asar": true,
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis"
    }
  },
  "type": "module"
}
